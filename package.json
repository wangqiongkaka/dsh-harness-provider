{
  "name": "dsh-harness-provider",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "probe": "node experiments/dsh-extension-probe.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "dev:link": "node scripts/link-references.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "probe:codex": "node experiments/codex-native-probe.mjs",
    "probe:codex-capabilities": "node experiments/codex-capabilities-probe.mjs",
    "probe:web": "node experiments/dsh-web-probe.mjs",
    "probe:claude": "node experiments/claude-native-probe.mjs",
    "probe:claude-capabilities": "node experiments/claude-capabilities-probe.mjs"
  },
  "files": [
    "dist/dsh.js",
    "dist/client.js",
    "dist/delegate-cli.mjs",
    "dist/claude-history-cli.js",
    "dist/licenses",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.png",
    "docs/implementation-status.md"
  ],
  "main": "dist/dsh.js",
  "exports": {
    ".": "./dist/dsh.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
